{
  "framework": null,
  "buildCommand": "cd Pashudhan-Lens-main && npm run build",
  "outputDirectory": "Pashudhan-Lens-main/dist",
  "installCommand": "cd Pashudhan-Lens-main && npm install",
  "devCommand": "cd Pashudhan-Lens-main && npm run dev",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
